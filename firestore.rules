rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth != null; }
    match /usernames/{n} {
      allow read: if me();
      allow create: if me() && request.resource.data.uid == request.auth.uid;
    }
    match /users/{u} {
      allow read: if me();
      allow create, update: if me() && request.auth.uid == u;
      match /following/{f} {
        allow read: if me();
        allow write: if me() && request.auth.uid == u;
      }
    }
    match /posts/{p} {
      allow read: if me();
      allow create: if me() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text.size() <= 1000;
      allow update: if me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if me() && resource.data.uid == request.auth.uid;
    }
    match /chats/{c} {
      allow read, update: if me() && request.auth.uid in resource.data.members;
      allow create: if me() && request.auth.uid in request.resource.data.members;
      match /messages/{m} {
        allow read: if me() && request.auth.uid in get(/databases/$(db)/documents/chats/$(c)).data.members;
        allow create: if me() && request.resource.data.from == request.auth.uid
          && request.resource.data.text.size() <= 2000
          && request.auth.uid in get(/databases/$(db)/documents/chats/$(c)).data.members;
      }
    }
  }
}
